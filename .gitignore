# Archivos que NO se suben a GitHub.

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Node / frontend
node_modules/
dist/

# Datos y caché (pesan mucho y se pueden volver a descargar). El .gitkeep sí se sube: el
# Dockerfile del backend necesita que la carpeta exista.
**/cache/*
!**/cache/.gitkeep
*.fits

# Secretos y configuración local
.env
.env.local

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
