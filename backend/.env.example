# Ejemplo de configuración del backend.
# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores.
# El archivo .env real NUNCA se sube a git.

# Colección o versión de datos de SPHEREx en IRSA.
# PENDIENTE: confirmar en la documentación de IRSA cuál está vigente (QR3 / DR1).
COLECCION_SPHEREX=

# Campo de visión máximo permitido, en grados (valor provisional).
FOV_MAX=0.5

# Páginas que pueden llamar a la API, separadas por comas (agregar la URL de Vercel).
CORS_ORIGINS=http://localhost:5173

# 1 = responder datos falsos (mock); 0 = datos reales.
USAR_MOCK=0
